# ── LLM providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Web search / scraping ─────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
COHERE_API_KEY=...

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/content_engine
REDIS_URL=redis://localhost:6379/0

# ── Observability ─────────────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=ai-content-engine

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Engine behaviour ──────────────────────────────────────────────────────────
MAX_REVISION_ITERATIONS=3
MAX_RECURSION_LIMIT=50
TOKEN_BUDGET_PER_RUN=80000
NODE_TIMEOUT_SECONDS=60
GLOBAL_RUN_TIMEOUT_SECONDS=600
PRIMARY_MODEL=anthropic:claude-sonnet-4-6
REVIEW_MODEL=openai:gpt-4o
FAST_MODEL=anthropic:claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# ── Publishing ────────────────────────────────────────────────────────────────
WORDPRESS_URL=https://yourblog.com
WORDPRESS_USERNAME=admin
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
